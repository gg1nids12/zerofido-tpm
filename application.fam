import os


# tpm branch (2026-11-06): the "nfc" profile is gone with the NFC transport
# (owner: "NFC out of the project — too complicated and not needed"). What is
# left: "usb" (USB HID only) and "full" (USB HID + Bluetooth LE FIDO).
profile = os.environ.get("ZEROFIDO_PROFILE", "usb").lower()
if profile not in ("usb", "full"):
    raise ValueError("ZEROFIDO_PROFILE must be one of: usb, full")

def env_flag(name, default=False):
    value = os.environ.get(name)
    if value is None:
        return default
    value = value.lower()
    if value in ("1", "true", "yes", "on"):
        return True
    if value in ("0", "false", "no", "off"):
        return False
    raise ValueError(f"{name} must be a boolean value")


release_diagnostics = env_flag("ZEROFIDO_RELEASE_DIAGNOSTICS", False)
usb_diagnostics = env_flag("ZEROFIDO_USB_DIAGNOSTICS", False)
auto_accept_requests = env_flag("ZEROFIDO_AUTO_ACCEPT_REQUESTS", False)
dev_screenshot = env_flag("ZEROFIDO_DEV_SCREENSHOT", False)
dev_fido2_1 = env_flag("ZEROFIDO_DEV_FIDO2_1", False)
# tpm branch (2026-11-05): defaults off to fit the Momentum heap; the owner
# does not need attestation or legacy U2F inside ZeroFIDO (built-in Flipper U2F
# stays for SSH). Turn back on with ZEROFIDO_PACKED_ATTESTATION=1 / ZEROFIDO_U2F=1.
packed_attestation = env_flag("ZEROFIDO_PACKED_ATTESTATION", False)
u2f_enabled = env_flag("ZEROFIDO_U2F", False)
# tpm branch (2026-11-05): Bluetooth LE FIDO (Windows) in the universal build.
ble_enabled = env_flag("ZEROFIDO_BLE", True) and profile == "full"
# tpm branch (2026-11-06): service trace (/ext/apps_data/zerofido/trace.txt):
# command codes, status codes and timings only. On while the branch is in
# development; ZEROFIDO_TRACE=0 turns it off.
tpm_trace = env_flag("ZEROFIDO_TRACE", True)

cdefines = [
    f"ZF_RELEASE_DIAGNOSTICS={1 if release_diagnostics else 0}",
    f"ZF_USB_DIAGNOSTICS={1 if usb_diagnostics else 0}",
    f"ZF_AUTO_ACCEPT_REQUESTS={1 if auto_accept_requests else 0}",
    f"ZF_DEV_SCREENSHOT={1 if dev_screenshot else 0}",
    f"ZF_DEV_FIDO2_1={1 if dev_fido2_1 else 0}",
    f"ZF_PACKED_ATTESTATION={1 if packed_attestation else 0}",
    f"ZF_U2F_DISABLED={0 if u2f_enabled else 1}",
    f"ZF_BLE_ENABLED={1 if ble_enabled else 0}",
    f"ZF_TPM_TRACE={1 if tpm_trace else 0}",
]
sources = [
    "*.c",
    "!.git",
    "!.github",
    "!.idea",
    "!.tmp",
    "!.ufbt",
    "!.venv",
    "!.vscode",
    "!__pycache__",
    "!dist",
    "!docs",
    "!fixtures",
    "!host_tools",
    "!include",
    "!metadata",
    "!tests",
    "!tools",
    "!*_debug.c",
    "!debug_*.c",
    "!*_diag.c",
    "!diag_*.c",
    "!*_fixture.c",
    "!fixture_*.c",
    "!*_test.c",
    "!test_*.c",
]
requires = [
    "gui",
    "storage",
    "notification",
]
description = "FIDO2 for Flipper Zero"
if profile == "usb":
    cdefines.append("ZF_USB_ONLY")

if not u2f_enabled:
    sources.append("!u2f")
if ble_enabled:
    requires.append("bt")
else:
    sources.append("!ble_*.c")

if not usb_diagnostics:
    sources.append("!zerofido_usb_diagnostics.c")

App(
    appid="zerofido",
    name="ZeroFIDO",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="zerofido_main",
    stack_size=4 * 1024,
    sources=sources,
    cdefines=cdefines,
    requires=requires,
    fap_icon="icon.png",
    fap_category="Tools",
    fap_description=description,
    fap_author="Alex Stoyanov",
    fap_version=(0, 8),
)
